ANTHROPIC_API_KEY=sk-ant-...

# Required: every browser — including this PC's — signs in once with this
# password (the session lasts 30 days). Use a long one if the app is
# reachable through a tunnel. The secret signs the login cookie; generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ULTRON_APP_PASSWORD=
ULTRON_SESSION_SECRET=

# Optional: default city for weather and the morning briefing (Open-Meteo,
# no key needed), e.g. "Pune, India". Without it ULTRON asks the first time.
ULTRON_HOME_LOCATION=

# Optional: powers web_search (agent reads live search results and answers
# from them). Without it, the agent falls back to open_search (opens a
# results page in the browser instead). Get a free-tier key at
# https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# One unified Google connection powering Gmail, YouTube (liked videos),
# Calendar, Drive, Contacts, Tasks, and Photos — a single OAuth flow with
# all scopes requested together. Create an OAuth client (type "Web
# application") at https://console.cloud.google.com/apis/credentials with
# redirect URI http://localhost:3000/api/gmail/callback (kept as-is even
# though it now covers everything, not just Gmail), then in "APIs &
# Services > Library" enable: Gmail API, YouTube Data API v3, Google
# Calendar API, Google Drive API, People API, Tasks API, and Photos
# Library API. Visit /api/gmail/auth once in your browser to connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Optional: powers call_health_report (Ultron calls your phone and reads out
# a machine health + important-email summary). Create a free Twilio trial
# account at https://www.twilio.com/try-twilio, buy/claim a Twilio phone
# number, and get your Account SID + Auth Token from the console dashboard.
# Both numbers must be in E.164 format (e.g. +15551234567). On a trial
# account, USER_PHONE_NUMBER must first be verified in the Twilio console
# under Phone Numbers > Verified Caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_PHONE_NUMBER=
# Public HTTPS URL Twilio can reach to fetch what to say (a Cloudflare quick
# tunnel URL from `cloudflared tunnel --url http://localhost:3000`, or an
# ngrok URL). Changes every time you restart the tunnel.
PUBLIC_URL=

# The assistant's spoken voice, in priority order: Piper (local, offline,
# free forever — no env var needed, just install it at
# ~/.ultron/piper/piper/ with a voice model alongside piper.exe; see
# https://github.com/rhasspy/piper) > ElevenLabs (optional paid upgrade,
# nicer voice quality, needs credits) > the browser's built-in speech
# synthesis (robotic, last resort). Each tier only kicks in if the one
# above it is missing or fails, so nothing here is required.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: powers play_video with accurate results (the real YouTube Data
# API instead of a generic web-search guess). Create a project at
# https://console.cloud.google.com/apis/credentials, enable "YouTube Data
# API v3", and create an API key (no OAuth needed, just search). Without
# this, play_video falls back to a Brave-search-based guess.
YOUTUBE_API_KEY=

# Optional: powers spotify_play/pause/next/previous (real playback control,
# not just launching the app). Create an app at
# https://developer.spotify.com/dashboard, add redirect URI
# http://127.0.0.1:3000/api/spotify/callback (Spotify flags "localhost" as
# insecure and requires the literal loopback IP instead), then visit
# /api/spotify/auth once in your browser to connect your account. Remote
# playback control requires a Spotify Premium account.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# ── Optional integrations ──────────────────────────────────────────────

# Documents: extra folders ULTRON may search and read (read-only), separated
# by semicolons. The agent workspace (~/ULTRON-Agent-Files) is always included.
# e.g. C:\Users\you\Documents;D:\Papers
ULTRON_DOCUMENT_FOLDERS=

# WhatsApp: country code added to local numbers without one (91 = India).
ULTRON_DEFAULT_COUNTRY_CODE=91

# Telegram: text ULTRON from your phone, and get background notices there.
# Create a bot with @BotFather and paste its token. Then message the bot —
# it replies with your chat id — and put that here (comma-separate several).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Smart Life / Tuya lights, plugs and switches (Wipro, Syska, Halonix...).
# One-time setup, ~10 minutes — see README "Smart home". Region: in (India),
# eu, us, cn, sg... — the data centre your Smart Life account is in.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=in

# Android / Google TV over Wi-Fi. The TV's IP address (Settings > Network on
# the TV); run scripts\install-adb.ps1 once and turn on debugging on the TV
# (README "Smart home"). ANDROID_TV_MAC is optional — ULTRON learns it.
ANDROID_TV_HOST=
ANDROID_TV_MAC=

# Home Assistant: smart-home control. URL like http://homeassistant.local:8123;
# token from your HA profile page > Long-lived access tokens.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Country for news headlines (two letters, default IN).
ULTRON_NEWS_REGION=

# Set to "off" to never consult the bigger model on hard questions (also a
# switch in Settings).
ULTRON_ADVISOR=
