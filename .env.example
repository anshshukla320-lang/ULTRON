ANTHROPIC_API_KEY=sk-ant-...

# Optional: powers web_search (agent reads live search results and answers
# from them). Without it, the agent falls back to open_search (opens a
# results page in the browser instead). Get a free-tier key at
# https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# Optional: powers Gmail read/send tools. Create an OAuth client (type "Web
# application") at https://console.cloud.google.com/apis/credentials with
# redirect URI http://localhost:3000/api/gmail/callback, then visit
# /api/gmail/auth once in your browser to connect your account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Optional: powers call_health_report (Ultron calls your phone and reads out
# a machine health + important-email summary). Create a free Twilio trial
# account at https://www.twilio.com/try-twilio, buy/claim a Twilio phone
# number, and get your Account SID + Auth Token from the console dashboard.
# Both numbers must be in E.164 format (e.g. +15551234567). On a trial
# account, USER_PHONE_NUMBER must first be verified in the Twilio console
# under Phone Numbers > Verified Caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_PHONE_NUMBER=
# Public HTTPS URL Twilio can reach to fetch what to say (a Cloudflare quick
# tunnel URL from `cloudflared tunnel --url http://localhost:3000`, or an
# ngrok URL). Changes every time you restart the tunnel.
PUBLIC_URL=

# Optional: powers spotify_play/pause/next/previous (real playback control,
# not just launching the app). Create an app at
# https://developer.spotify.com/dashboard, add redirect URI
# http://127.0.0.1:3000/api/spotify/callback (Spotify flags "localhost" as
# insecure and requires the literal loopback IP instead), then visit
# /api/spotify/auth once in your browser to connect your account. Remote
# playback control requires a Spotify Premium account.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
